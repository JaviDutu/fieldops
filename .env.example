# Optional: enables live Sentinel-2 NDVI in /api/ndvi.
# Without these, the endpoint automatically falls back to demo NDVI values.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Required: secret used to sign session cookies (lib/auth.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
